# Docker Compose Environment Variables
# Copy this file to .env and fill in the values

APP_KEY=base64:CHANGE_ME_RUN_php_artisan_key_generate
DB_DATABASE=lab_inventory
DB_USERNAME=laravel
DB_PASSWORD=secret123
DB_ROOT_PASSWORD=rootsecret123

# Grafana Credentials (Gunakan kata sandi kuat di file .env lokal Anda)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
